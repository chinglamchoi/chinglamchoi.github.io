---
import '../styles/global.css';
import site from '../data/site.json';
import Icon from '../components/Icon.astro';
import { href } from '../lib/site';
const { title = '', description = site.description, active = '', wide = false } = Astro.props;
const nav = [{id:'home',label:'About',path:''},{id:'research',label:'Research',path:'research/'},{id:'writing',label:'Writing',path:'writing/'},{id:'news',label:'News & talks',path:'news/'},{id:'coffee',label:'Coffee hours',path:'coffee/'},{id:'about',label:'Beyond research',path:'about/'}];
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · MIT CSAIL`;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{pageTitle}</title><meta name="description" content={description}/><meta name="theme-color" content="#ffffff"/><link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}/><meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:image" content={new URL(href('media/chinglamchoi-960.webp'), Astro.site)}/><link rel="icon" href={href('favicon/rosetta.ico')}/><link rel="icon" type="image/png" sizes="32x32" href={href('favicon/rosetta-32.png')}/><link rel="apple-touch-icon" sizes="180x180" href={href('favicon/apple-touch-icon.png')}/><script is:inline>document.documentElement.classList.add('js');</script></head>
<body data-base={href()}><a class="skip-link" href="#main">Skip to content</a>
  <header class="mobile-header"><a href={href()}><img class="mobile-brand-mark" src={href('brand/rosetta-green-96.png')} width="30" height="30" alt="" aria-hidden="true"/>Ching Lam CHOI<span>MIT CSAIL</span></a><button class="icon-button" id="menu-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="sidebar"><Icon name="menu"/></button></header>
  <aside class="sidebar" id="sidebar"><a class="sidebar-name" href={href()}>Ching Lam<br/>CHOI<span>PhD student · MIT CSAIL</span></a><nav aria-label="Main navigation">{nav.map(n=><a class:list={['nav-link',{active:active===n.id}]} href={href(n.path)} aria-current={active===n.id?'page':undefined}><Icon name={n.id}/><span>{n.label}</span></a>)}</nav><button type="button" class="search-trigger js-only" data-open-search><Icon name="search"/><span>Search the site</span><kbd>⌘ K</kbd></button><div class="sidebar-bottom"><p>Elsewhere</p><a href={site.socials[0].url}>Google Scholar ↗</a><a href={site.socials[1].url}>GitHub ↗</a><a href={`mailto:${site.email}`}>Email ↗</a><div class="colour-rule" aria-hidden="true"><i></i><i></i><i></i><i></i></div><span>Research & a few other things.</span></div></aside>
  <div class:list={['page-shell',{wide}]}><main id="main"><slot/></main><footer class="site-footer"><span><img src={href('brand/rosetta-green-96.png')} width="24" height="24" alt="" aria-hidden="true"/>Ching Lam CHOI</span><div><a href={`mailto:${site.email}`}>Get in touch</a><a href="#main">Back to top ↑</a></div></footer></div>
  <dialog id="search-dialog" class="search-dialog" aria-labelledby="search-title"><div class="dialog-heading"><h2 id="search-title">Search</h2><button class="icon-button" data-close-dialog aria-label="Close search"><Icon name="close"/></button></div><label class="sr-only" for="site-search">Search papers, writing and pages</label><input id="site-search" type="search" placeholder="Papers, topics, people…" autocomplete="off"/><p id="search-status" class="small" role="status">Start typing to search the site.</p><ul id="search-results"></ul><p class="dialog-help">Search papers, writing and pages <span>Esc to close</span></p></dialog>
  <dialog id="citation-dialog" class="citation-dialog" aria-labelledby="citation-title"><div class="dialog-heading"><h2 id="citation-title">BibTeX</h2><button class="icon-button" data-close-dialog aria-label="Close citation"><Icon name="close"/></button></div><pre><code id="citation-content"></code></pre><div class="citation-actions"><button class="button" id="citation-copy">Copy citation</button><a id="citation-download" download>Download .bib</a></div><p id="citation-status" class="small" role="status"></p></dialog>
  <script>import '../scripts/global';</script>
</body></html>
