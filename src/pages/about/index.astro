---
import Base from '../../layouts/Base.astro';
import Pattern from '../../components/Pattern.astro';
import Photo from '../../components/Photo.astro';
import interests from '../../data/interests.json';
import books from '../../data/books.json';
import site from '../../data/site.json';
const categories=[...new Set(books.map(b=>b.category))];
---
<Base title="Beyond research" active="about"><header class="page-heading"><p class="eyebrow">Beyond research</p><h1>A few other things.</h1><p>I am an amateur of many trades for my own amusement. I’m easily moved by words, music, nature, Hugh Laurie; utterly immovable by non-climbing gym memberships, organised religion, and oatmeal.</p></header><blockquote class="personal-quote">“We are not nouns, we are verbs.”<cite>Stephen Fry</cite></blockquote><nav class="section-jumps" aria-label="Personal interests"><a href="#outdoors">Outdoors</a><a href="#music">Music</a><a href="#reading">Reading</a></nav>
<section id="outdoors" class="interest-section"><div><p class="eyebrow cyan">Outside</p><h2>On a wall, or on a trail.</h2><div class="interest-copy" set:html={interests[0].html}/></div><figure><Photo name="bouldering" alt="Reaching for the next hold on a climbing wall" sizes="(max-width: 700px) 90vw, 560px"/><figcaption>Finding the next move.</figcaption></figure></section>
<section id="music" class="interest-section reverse"><div><Pattern name="record" class="interest-motif"/><p class="eyebrow rose">Listening</p><h2>Strings, winds, and voices.</h2><p>I adore the cello, oboe, French horn, voice, and violin.</p><details><summary>Some favourites</summary><div set:html={interests[1].html}/></details></div><figure><Photo name="hilaryHahn" alt={interests[1].alt} sizes="(max-width: 700px) 90vw, 480px"/><figcaption>With Hilary Hahn after Mendelssohn in Dortmund.</figcaption></figure></section>
<section id="reading" class="reading-section"><div class="reading-scene"><figure><Photo name="reading-wall" alt="A wall of colourful reading notes in a museum" sizes="(max-width: 700px) 90vw, 440px"/><figcaption>Words to linger over.</figcaption></figure><Pattern name="books"/></div><div class="section-heading"><div><p class="eyebrow violet">Reading</p><h2>Books I travel with.</h2></div><a href={site.socials.find(s=>s.label==='Goodreads')?.url}>On Goodreads ↗</a></div><p>A few favourites from the shelf.</p><div class="topic-filters js-only" role="group" aria-label="Filter books by category">{['All',...categories].map(c=><button data-book-filter={c} aria-pressed={c==='All'?'true':'false'}>{c}</button>)}</div><p class="sr-only" id="book-count" role="status">{books.length} books</p><div class="bookshelf">{books.map((b,i)=><article data-book data-category={b.category} class={`book book-${i%4}`}><p class="book-category">{b.category}</p><h3>{b.title}</h3><p>{b.author}</p></article>)}</div></section><script>const buttons=document.querySelectorAll<HTMLButtonElement>('[data-book-filter]');buttons.forEach(b=>b.addEventListener('click',()=>{let count=0;document.querySelectorAll<HTMLElement>('[data-book]').forEach(n=>{n.hidden=b.dataset.bookFilter!=='All'&&n.dataset.category!==b.dataset.bookFilter;if(!n.hidden)count++;});buttons.forEach(x=>x.setAttribute('aria-pressed',String(x===b)));document.getElementById('book-count')!.textContent=`${count} books`;}));</script></Base>
