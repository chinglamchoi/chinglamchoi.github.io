---
import Base from '../../layouts/Base.astro';
import news from '../../data/news.json';
import { formatDate } from '../../lib/site';
const entries=[...news].sort((a,b)=>b.date.localeCompare(a.date));
---
<Base title="News & talks" active="news"><header class="page-heading"><p class="eyebrow">In and around research</p><h1>News & talks</h1><p>Talks, visits, gatherings, and community work.</p></header><div class="topic-filters js-only" role="group" aria-label="News category">{['All','Talks','Milestones','Community'].map(c=><button data-news-filter={c} aria-pressed={c==='All'?'true':'false'}>{c}</button>)}</div><p id="news-count" class="result-count js-only" role="status">{entries.length} entries</p><div class="news-timeline">{entries.map(n=><article data-news data-category={n.category}><div class="news-date">{n.date?<time datetime={n.date}>{n.displayDate || formatDate(n.date)}</time>:<span>Service</span>}<span class="news-category">{n.category}</span></div><div>{!n.date && <h3 class="service-role">{n.label}</h3>}<div set:html={n.html.replace(/^\s*\[.*?\]\s*/, '')}/></div></article>)}</div><script>const buttons=document.querySelectorAll<HTMLButtonElement>('[data-news-filter]');buttons.forEach(b=>b.addEventListener('click',()=>{let count=0;document.querySelectorAll<HTMLElement>('[data-news]').forEach(n=>{n.hidden=b.dataset.newsFilter!=='All'&&n.dataset.category!==b.dataset.newsFilter;if(!n.hidden)count++;});buttons.forEach(x=>x.setAttribute('aria-pressed',String(x===b)));document.getElementById('news-count')!.textContent=`${count} entries`;}));</script></Base>
