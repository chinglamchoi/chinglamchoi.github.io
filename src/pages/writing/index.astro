---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';
import { href,formatDate,readingTime } from '../../lib/site';
const posts=(await getCollection('posts',({data})=>!data.draft)).sort((a,b)=>b.data.date.getTime()-a.data.date.getTime());
---
<Base title="Writing" active="writing"><header class="page-heading"><p class="eyebrow">Notes & essays</p><h1>Writing</h1><p>Ideas from research, questions worth keeping, and the occasional longer explanation.</p></header>{posts.length === 0 ? <section class="writing-coming-soon" aria-labelledby="coming-soon"><h2 id="coming-soon">Coming soon</h2></section> : <div class="writing-list">{posts.map(post=><article><div class="post-meta"><span>{post.data.category}</span><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span>{readingTime(post.body)} min read</span></div><h2><a href={href(`writing/${post.id}/`)}>{post.data.title}</a></h2><p>{post.data.description}</p><a class="text-link" href={href(`writing/${post.id}/`)}>Read the note <Icon name="arrow" size={16}/></a></article>)}</div>}</Base>
