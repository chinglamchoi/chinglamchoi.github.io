---
import Base from '../../layouts/Base.astro';
import { getCollection,render } from 'astro:content';
import { href,formatDate,readingTime } from '../../lib/site';
export async function getStaticPaths(){return (await getCollection('posts',({data})=>!data.draft)).map(post=>({params:{id:post.id},props:{post}}));}
const {post}=Astro.props;const {Content,headings}=await render(post);
---
<Base title={post.data.title} description={post.data.description} active="writing"><a class="back-link" href={href('writing/')}>← Writing</a><header class="article-heading"><div class="post-meta"><span>{post.data.category}</span><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span>{readingTime(post.body)} min read</span></div><h1>{post.data.title}</h1><p>{post.data.description}</p></header><div class="article-layout"><article class="prose article-body"><Content/></article><aside class="article-toc"><p>On this page</p><nav aria-label="Article contents">{headings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}</nav></aside></div><div class="article-end"><a href={href('writing/')}>← More writing</a><a href={href('coffee/')}>Talk about this over coffee ↗</a></div></Base>
