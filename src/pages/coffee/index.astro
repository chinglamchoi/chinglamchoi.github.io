---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import site from '../../data/site.json';
---
<Base title="Coffee hours" active="coffee"><header class="page-heading"><p class="eyebrow">A conversation, perhaps?</p><h1>Coffee hours<span class="name-period">.</span></h1><p>Research questions, PhD life, shared interests, or an idea that’s easier to talk through than type out.</p></header><div class="coffee-layout"><section class="coffee-main"><div class="coffee-drawing" aria-hidden="true"><svg viewBox="0 0 400 230"><path d="M93 76h178v61c0 36-29 65-65 65h-48c-36 0-65-29-65-65z" fill="#fff" stroke="#2572cc" stroke-width="3"/><path d="M271 90h18c46 0 46 63 0 63h-18" fill="none" stroke="#2572cc" stroke-width="3"/><path d="M73 209h242" stroke="#7a4ccc" stroke-width="3"/><path d="M144 53c-23-20 23-22 0-44M187 53c-23-20 23-22 0-44M230 53c-23-20 23-22 0-44" fill="none" stroke="#0099ac" stroke-width="3"/><circle cx="148" cy="119" r="6" fill="#dc426c"/><circle cx="217" cy="119" r="6" fill="#dc426c"/><path d="M166 139q18 15 35 0" fill="none" stroke="#2572cc" stroke-width="3"/></svg></div><h2>{site.bookingUrl ? 'Find a time to talk.' : site.coffeeStatus}</h2>{site.bookingUrl?<><p>Choose a time that works for you using my booking calendar.</p><a class="button primary" href={site.bookingUrl}>Open booking calendar ↗</a></>:<><p>Online booking isn’t open yet. In the meantime, you can email me to arrange a conversation.</p><a class="text-link" href={`mailto:${site.email}`}>{site.email} <Icon name="external" size={14}/></a></>}</section><section class="coffee-note"><h2>What’s on your mind?</h2><p class="small">Start with a topic, then add a little context.</p><form id="coffee-form" data-email={site.email}><fieldset><legend>Topic</legend><div class="coffee-topics">{['Research','PhD life','Shared interests','Something else'].map((t,i)=><label><input type="radio" name="topic" value={t} checked={i===0}/><span>{t}</span></label>)}</div></fieldset><label for="coffee-name">Your name</label><input id="coffee-name" name="name" autocomplete="name" placeholder="How should I address you?" required maxlength="100"/><label for="coffee-context">A little context</label><textarea id="coffee-context" name="context" rows="4" placeholder="What would you like to chat about?" maxlength="2000" required></textarea><button type="submit" class="button primary">Draft an email <Icon name="mail" size={16}/></button><p class="small form-note">Opens your email app. Nothing is booked or sent automatically.</p><noscript><a href={`mailto:${site.email}`}>Email me directly</a></noscript></form></section></div><script>const form=document.querySelector<HTMLFormElement>('#coffee-form');form?.addEventListener('submit',e=>{e.preventDefault();const d=new FormData(form);const subject=`Coffee chat: ${d.get('topic')}`;const body=`Hi Ching Lam,\n\n${d.get('context')}\n\nBest,\n${d.get('name')}`;window.location.href=`mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;});</script></Base>
